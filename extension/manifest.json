{
    "manifest_version": 3,
    "name": "Twitter Bot Detector",
    "description": "Test extention.",
    "version": "0.0.1",
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://*.twitter.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "./IMG/icon16.png",
        "48": "./IMG/icon48.png",
        "128": "./IMG/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "./IMG/icon16.png",
            "48": "./IMG/icon48.png",
            "128": "./IMG/icon128.png"
        },
        "default_title": "Twitter Bot Detector",
        "default_popup": "popup.html"
    },
    "content_scripts": [{
        "matches": ["https://*.twitter.com/*"],
        "js": ["contentScript.js"]
    }]
}